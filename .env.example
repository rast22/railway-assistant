# Server configuration
PORT=8080

# Telegram bot configuration
# Create this with @BotFather.
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Comma-separated Telegram user IDs allowed to manage routes with bot commands.
# Example: ADMIN_TELEGRAM_USER_IDS=123456789,987654321
ADMIN_TELEGRAM_USER_IDS=your_telegram_user_id_here

# Poll Telegram for bot commands. No Telegram webhook is required.
TELEGRAM_POLLING_ENABLED=true

# Durable routing config
# On Railway, attach a Volume and leave CONFIG_PATH empty. Railway provides
# RAILWAY_VOLUME_MOUNT_PATH automatically, and the app stores config at:
# ${RAILWAY_VOLUME_MOUNT_PATH}/railway-assistant/config.json
CONFIG_PATH=

# Optional Railway webhook protection
# If set, Railway requests must include X-Railway-Webhook-Token or ?token=...
RAILWAY_WEBHOOK_TOKEN=

# Legacy Telegram fallback
# Used only when no project route matches.
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true

# Slack configuration
# Slack remains global/legacy for now.
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=

# Optional message content controls (default: true)
INCLUDE_WORKSPACE=true
INCLUDE_STATUS=true
INCLUDE_BRANCH=true
INCLUDE_COMMIT=true
INCLUDE_AUTHOR=true
